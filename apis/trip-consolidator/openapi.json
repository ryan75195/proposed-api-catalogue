{
  "openapi": "3.1.0",
  "info": {
    "title": "Trip Consolidator",
    "description": "Merges supplied trip bookings into one itinerary and flags conflicts and gaps.",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "https://example.invalid"
    }
  ],
  "paths": {
    "/trips/consolidate": {
      "post": {
        "summary": "Consolidate trip bookings",
        "description": "Merges supplied booking records into an itinerary and flags conflicts or gaps.",
        "tags": [
          "travel/accessibility"
        ],
        "operationId": "trip-consolidator-post-trips-consolidate",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Trip consolidated.",
            "content": {
              "application/json": {
                "example": {
                  "itinerary": [],
                  "conflicts": [
                    {
                      "type": "overlap"
                    }
                  ],
                  "gaps": 1
                },
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "No valid bookings supplied."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "bookings"
                ],
                "properties": {
                  "bookings": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}