{
  "openapi": "3.1.0",
  "info": {
    "title": "Director Crosscheck",
    "description": "Lists the registered directorships of a person across companies for background checks.",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "https://example.invalid"
    }
  ],
  "paths": {
    "/people/{personId}/directorships": {
      "get": {
        "summary": "List a person's directorships",
        "description": "Returns the registered directorships of a person across companies.",
        "tags": [
          "business records"
        ],
        "operationId": "director-crosscheck-get-people-personid-directorships",
        "parameters": [
          {
            "name": "personId",
            "in": "path",
            "required": true,
            "description": "Person identifier.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Directorships returned.",
            "content": {
              "application/json": {
                "example": {
                  "companies": [
                    {
                      "regNo": "1234",
                      "role": "director",
                      "status": "active"
                    }
                  ]
                },
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Person not found."
          }
        }
      }
    }
  }
}