{
  "openapi": "3.1.0",
  "info": {
    "title": "Feature Flag Audit",
    "description": "Reports rollout and staleness for registered feature flags so teams can retire dead toggles.",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "https://example.invalid"
    }
  ],
  "paths": {
    "/flags": {
      "get": {
        "summary": "List flags and their state",
        "description": "Returns registered feature flags with rollout, last modification and staleness.",
        "tags": [
          "developer operations"
        ],
        "operationId": "feature-flag-audit-get-flags",
        "parameters": [
          {
            "name": "staleOlderThanDays",
            "in": "query",
            "required": false,
            "description": "Only include flags unmodified for this many days.",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Flags listed.",
            "content": {
              "application/json": {
                "example": {
                  "flags": [
                    {
                      "name": "new-checkout",
                      "rollout": 0.0,
                      "modified": "2025-01-02"
                    }
                  ],
                  "count": 1
                },
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  }
}