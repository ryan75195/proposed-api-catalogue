{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprenticeship Suitability",
    "description": "Indicates whether a role is plausibly apprenticeship-eligible and at what level from published rules.",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "https://example.invalid"
    }
  ],
  "paths": {
    "/suitability": {
      "get": {
        "summary": "Assess apprenticeship suitability",
        "description": "Returns whether a described role is plausibly apprenticeship-eligible and its level.",
        "tags": [
          "education/workforce"
        ],
        "operationId": "apprenticeship-suitability-get-suitability",
        "parameters": [
          {
            "name": "role",
            "in": "query",
            "required": true,
            "description": "Job role.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "employerSize",
            "in": "query",
            "required": false,
            "description": "Employer headcount.",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Suitability assessed.",
            "content": {
              "application/json": {
                "example": {
                  "eligible": true,
                  "level": 4,
                  "caveats": [
                    "check approved framework"
                  ]
                },
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "No rule matched."
          }
        }
      }
    }
  }
}