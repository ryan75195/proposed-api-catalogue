{
  "openapi": "3.1.0",
  "info": {
    "title": "Form Data Extraction",
    "description": "Reads structured fields from a scanned form image for downstream document workflows.",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "https://example.invalid"
    }
  ],
  "paths": {
    "/forms/extract": {
      "post": {
        "summary": "Extract fields from a form",
        "description": "Returns structured fields read from a supplied scanned form image.",
        "tags": [
          "media/documents"
        ],
        "operationId": "form-fill-extract-post-forms-extract",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Fields extracted.",
            "content": {
              "application/json": {
                "example": {
                  "fields": [
                    {
                      "name": "customerRef",
                      "value": "C-9981",
                      "confidence": 0.93
                    }
                  ]
                },
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "415": {
            "description": "Unsupported image format."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "fileRef"
                ],
                "properties": {
                  "fileRef": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}