{
  "openapi": "3.1.0",
  "info": {
    "title": "Course Search",
    "description": "Searches a structured course catalogue by query, level and mode of study.",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "https://example.invalid"
    }
  ],
  "paths": {
    "/courses": {
      "get": {
        "summary": "Search the course catalogue",
        "description": "Returns courses matching a query with structured level and mode filters.",
        "tags": [
          "education/workforce"
        ],
        "operationId": "course-search-get-courses",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "description": "Search term.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "level",
            "in": "query",
            "required": false,
            "description": "Course level filter.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "mode",
            "in": "query",
            "required": false,
            "description": "Mode filter, e.g. online.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Courses returned.",
            "content": {
              "application/json": {
                "example": {
                  "courses": [
                    {
                      "id": "C-41",
                      "level": 6,
                      "durationWeeks": 12
                    }
                  ],
                  "count": 3
                },
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  }
}