{
  "openapi": "3.1.0",
  "info": {
    "title": "Learning Path Builder",
    "description": "Builds an ordered sequence of courses from a learner's start skills toward a stated goal.",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "https://example.invalid"
    }
  ],
  "paths": {
    "/paths": {
      "post": {
        "summary": "Build a learning path",
        "description": "Returns an ordered course sequence from a start skill set toward a goal.",
        "tags": [
          "education/workforce"
        ],
        "operationId": "learning-path-post-paths",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Path built.",
            "content": {
              "application/json": {
                "example": {
                  "steps": [
                    {
                      "course": "C-7",
                      "order": 1
                    }
                  ],
                  "estimatedHours": 60
                },
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Unknown goal."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "goal",
                  "current"
                ],
                "properties": {
                  "goal": {
                    "type": "string"
                  },
                  "current": {
                    "type": "array"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}