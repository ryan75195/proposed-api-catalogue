{
  "openapi": "3.1.0",
  "info": {
    "title": "Inventory Lookup",
    "description": "Resolves net SKU availability across warehouses and reservation pools for accurate catalogue display.",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "https://example.invalid"
    }
  ],
  "paths": {
    "/inventory/{sku}": {
      "get": {
        "summary": "Resolve net availability",
        "description": "Returns available, reserved and per-warehouse stock for an SKU.",
        "tags": [
          "ecommerce"
        ],
        "operationId": "inventory-lookup-get-inventory-sku",
        "parameters": [
          {
            "name": "sku",
            "in": "path",
            "required": true,
            "description": "Stock-keeping unit.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "warehouse",
            "in": "query",
            "required": false,
            "description": "Limit to a single warehouse.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Availability resolved.",
            "content": {
              "application/json": {
                "example": {
                  "sku": "SW-12",
                  "available": 38,
                  "reserved": 12,
                  "perWarehouse": {
                    "uk-east": 38
                  }
                },
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "SKU unknown."
          }
        }
      }
    }
  }
}