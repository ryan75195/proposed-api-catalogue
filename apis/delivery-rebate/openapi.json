{
  "openapi": "3.1.0",
  "info": {
    "title": "Delivery Rebate Ledger",
    "description": "Compares delivery outcomes to promised service levels and estimates claimable SLA rebates.",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "https://example.invalid"
    }
  ],
  "paths": {
    "/deliveries/{id}/assess": {
      "post": {
        "summary": "Assess a delivery against SLA",
        "description": "Compares actual delivery time to a promised service level and estimates a claimable rebate.",
        "tags": [
          "logistics"
        ],
        "operationId": "delivery-rebate-post-deliveries-id-assess",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Delivery identifier.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Assessment done.",
            "content": {
              "application/json": {
                "example": {
                  "slaMet": false,
                  "rebatePence": 250
                },
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Delivery not found."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "promised",
                  "actual"
                ],
                "properties": {
                  "promised": {
                    "type": "string"
                  },
                  "actual": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}