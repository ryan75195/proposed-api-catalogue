{
  "openapi": "3.1.0",
  "info": {
    "title": "Quiet Hour Locator",
    "description": "Returns venues near a location that self-declare a reduced-stimulus quiet hour.",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "https://example.invalid"
    }
  ],
  "paths": {
    "/quiet-hours": {
      "get": {
        "summary": "Find venues with quiet hours",
        "description": "Returns venues near a location that self-declare a reduced-stimulus quiet hour.",
        "tags": [
          "travel/accessibility"
        ],
        "operationId": "quiet-hour-locator-get-quiet-hours",
        "parameters": [
          {
            "name": "postcode",
            "in": "query",
            "required": true,
            "description": "Location postcode.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Venues returned.",
            "content": {
              "application/json": {
                "example": {
                  "venues": [
                    {
                      "name": "Central Library",
                      "when": "Sat 09:00-10:00"
                    }
                  ]
                },
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "No venues found nearby."
          }
        }
      }
    }
  }
}