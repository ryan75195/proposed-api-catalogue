{
  "openapi": "3.1.0",
  "info": {
    "title": "Caption & Transcribe",
    "description": "Produces a timed, speaker-labelled transcript or captions from an uploaded media file.",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "https://example.invalid"
    }
  ],
  "paths": {
    "/transcribe": {
      "post": {
        "summary": "Transcribe an audio or video file",
        "description": "Returns a timed, speaker-labelled transcript from a supplied media file reference.",
        "tags": [
          "media/documents"
        ],
        "operationId": "caption-transcribe-post-transcribe",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Transcript produced.",
            "content": {
              "application/json": {
                "example": {
                  "segments": [
                    {
                      "start": 0.0,
                      "end": 3.2,
                      "speaker": "A",
                      "text": "..."
                    }
                  ],
                  "format": "srt"
                },
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "415": {
            "description": "Unsupported media format."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "fileRef"
                ],
                "properties": {
                  "fileRef": {
                    "type": "string"
                  },
                  "format": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}