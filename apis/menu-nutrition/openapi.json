{
  "openapi": "3.1.0",
  "info": {
    "title": "Menu Nutrition Annotation",
    "description": "Estimates nutrition for a dish from ingredients and portion sizes for menu labelling.",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "https://example.invalid"
    }
  ],
  "paths": {
    "/dishes/annotate": {
      "post": {
        "summary": "Estimate dish nutrition",
        "description": "Estimates energy and macronutrients for a dish from its ingredients and portion sizes.",
        "tags": [
          "food/agriculture"
        ],
        "operationId": "menu-nutrition-post-dishes-annotate",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Estimate returned.",
            "content": {
              "application/json": {
                "example": {
                  "kcal": 312,
                  "proteinG": 12,
                  "allergens": []
                },
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "No ingredients supplied."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "ingredients"
                ],
                "properties": {
                  "ingredients": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}