{
  "openapi": "3.1.0",
  "info": {
    "title": "Draft Rewrite",
    "description": "Rewrites supplied text to a requested tone and length as a reviewable draft.",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "https://example.invalid"
    }
  ],
  "paths": {
    "/rewrite": {
      "post": {
        "summary": "Rewrite supplied text",
        "description": "Returns a rewritten version of supplied text for a requested tone and target length.",
        "tags": [
          "media/documents"
        ],
        "operationId": "draft-rewrite-post-rewrite",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Rewrite produced.",
            "content": {
              "application/json": {
                "example": {
                  "rewritten": "...",
                  "wordCount": 148,
                  "tone": "plain"
                },
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "No text supplied."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "text",
                  "tone"
                ],
                "properties": {
                  "text": {
                    "type": "string"
                  },
                  "tone": {
                    "type": "string"
                  },
                  "targetWords": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}